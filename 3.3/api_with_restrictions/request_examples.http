
# примеры API-запросов

GET http://localhost:8000/api/advertisements/

@baseUrl = http://localhost:8000/api

###

# получение объявлений

GET {{baseUrl}}/advertisements/
Content-Type: application/json

###

# создание объявления
# POST {{baseUrl}}/advertisements/
POST http://localhost:8000/api/advertisements/
Content-Type: application/json
Authorization: Token 5eb105548b453dba691ce91b05a1cd33232ba34a
# Authorization: Token 902ef055a9ac93f18327f1f9c45ab059f1a62c7d

{
  "title": "Шкаф IKEA",
  "description": "Срочно"
}

###

# добавление объявления

POST http://localhost:8000/api/advertisements/
Content-Type: application/json
Authorization: Token 5eb105548b453dba691ce91b05a1cd33232ba34a

{
  "title": "Холодильник INDESIT",
  "description": "Очень хороший холодильник"
}

###

# попытка поменять объявление
PATCH {{baseUrl}}/advertisements/1/
Content-Type: application/json
Authorization: Token 5eb105548b453dba691ce91b05a1cd33232ba34a

{
  "status": "CLOSED"
  # "status": "CLOSED"
}

###

# фильтрация по создателю
GET {{baseUrl}}/advertisements/?creator=3
Content-Type: application/json

###

# фильтрация по дате
GET {{baseUrl}}/advertisements/?created_at_before=2020-10-01
# GET {{baseUrl}}/advertisements/?created_at_before=2020-10-01
Content-Type: application/json

###

# фильтрация по статусу OPEN
GET {{baseUrl}}/advertisements/?status=OPEN
Content-Type: application/json

###

# фильтрация по статусу CLOSE

GET {{baseUrl}}/advertisements/?status=CLOSED
Content-Type: application/json

###

# фильтрация по пользователю

GET {{baseUrl}}/advertisements/?creator=1
Content-Type: application/json

